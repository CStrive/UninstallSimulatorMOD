[sub_resource type="GDScript" id="GDScript_1n4qt"]
resource_name = "FastReaderUninstall"
script/source = "extends Control

#定义控件的引用
@onready var next1 = $WindowBG/WindowBGHBOX/ContentContainer/HBoxContainer/RightContent/MainContent/Next1
@onready var next2 = $WindowBG/WindowBGHBOX/ContentContainer/HBoxContainer/RightContent/MainContent/Next2
@onready var next3 = $WindowBG/WindowBGHBOX/ContentContainer/HBoxContainer/RightContent/MainContent/Next3
@onready var next_btn = $WindowBG/WindowBGHBOX/ContentContainer/HBoxContainer/RightContent/BottomBar/HBoxContainer/NextButton
@onready var uninstall_btn = $WindowBG/WindowBGHBOX/ContentContainer/HBoxContainer/RightContent/BottomBar/HBoxContainer/UninstallBtn
@onready var cancel_btn = $WindowBG/WindowBGHBOX/ContentContainer/HBoxContainer/RightContent/BottomBar/HBoxContainer/CancelButton
@onready var progress_bar = $WindowBG/WindowBGHBOX/ContentContainer/HBoxContainer/RightContent/MainContent/Next3/ProgressContainer/ProgressBarVis
@onready var progress_overlay = $WindowBG/WindowBGHBOX/ContentContainer/HBoxContainer/RightContent/MainContent/Next3/ProgressContainer/ProgressOverlay
@onready var progress_label = $WindowBG/WindowBGHBOX/ContentContainer/HBoxContainer/RightContent/MainContent/Next3/ProgressLabel
@onready var options_container = $WindowBG/WindowBGHBOX/ContentContainer/HBoxContainer/RightContent/MainContent/Next2/OptionsContainer
@onready var window_bg = $WindowBG
@onready var content_container = $WindowBG/WindowBGHBOX/ContentContainer
@onready var title_bar = $WindowBG/WindowBGHBOX/WindowTitleBar
@onready var close_btn = $WindowBG/WindowBGHBOX/WindowTitleBar/HBoxContainer/HBoxContainer/CloseBtn

#任务完成信号，必须定义
signal level_completed(success: bool)

var current_step = 1
var can_drag = false
var is_dragging = false
var host_ui:Node
var uninstall_completed = false
var host_window: Node

func _ready():
	#默认显示面板1
	_show_step(1)
	#连接按钮
	next_btn.pressed.connect(_on_next_pressed)
	uninstall_btn.pressed.connect(_on_uninstall_pressed)
	cancel_btn.pressed.connect(_on_cancel_pressed)
	close_btn.pressed.connect(_on_cancel_pressed)
	for child in options_container.get_children():
		if child is CheckBox:
			child.toggled.connect(_on_checkbox_toggled)
	
	host_window = get_node_or_null(\"HostWindow\")
	if host_window == null:
		return
	host_window.set_chromeless(true)
	window_bg.gui_input.connect(_on_window_surface_gui_input)
	content_container.gui_input.connect(_on_window_surface_gui_input)
	progress_overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	progress_overlay.gui_input.connect(_on_progress_overlay_gui_input)
	#设置窗口可拖动
	title_bar.gui_input.connect(_on_title_bar_gui_input)

func _on_window_surface_gui_input(event: InputEvent):
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		_activate_host_window()

func _on_title_bar_gui_input(event: InputEvent):
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		_activate_host_window()
	if host_window == null:
		return
	#拖动窗口
	host_window.handle_title_bar_input(event, title_bar.size.y)
func _show_step(step):
	current_step = step
	next1.visible = (step == 1)
	next2.visible = (step == 2)
	next3.visible = (step == 3)
	if step == 1:
		next_btn.text = \"下一步\"
		next_btn.visible = true
		uninstall_btn.visible = false
	elif step == 2:
		next_btn.visible = false
		uninstall_btn.visible = true
		uninstall_btn.text = \"立即卸载\"
		_update_uninstall_button_state()
	elif step == 3:
		next_btn.visible = false
		uninstall_btn.visible = false
		cancel_btn.text = \"卸载中...\"
		cancel_btn.disabled = true
		_start_fake_uninstall()

func _on_next_pressed():
	_show_step(current_step + 1)

func _on_uninstall_pressed():
	_show_step(3)

func _on_cancel_pressed():
	#如果卸载成功
	if uninstall_completed:
		#触发任务成功
		level_completed.emit(true)
	#关闭窗口
	$HostWindow.close_window()

func _activate_host_window():
	if host_window != null and host_window.has_method(\"activate_window\"):
		host_window.activate_window()

func _on_checkbox_toggled(_button_pressed):
	if current_step == 2:
		_update_uninstall_button_state()

func _update_uninstall_button_state():
	var any_checked = false
	for child in options_container.get_children():
		if child is CheckBox and child.button_pressed:
			any_checked = true
			break
	uninstall_btn.disabled = !any_checked

func _start_fake_uninstall():
	progress_bar.value = 0
	can_drag = false
	is_dragging = false
	var tween = create_tween()
	tween.tween_property(progress_bar, \"value\", 50, 3.0)
	var logs = [
		\"正在停用后台驱动服务...\",
		\"正在删除注册表项 HKEY_LOCAL_MACHINE\\\\SOFTWARE\\\\FastReader\",
		\"[错误 0x80070005] 访问被拒绝，核心组件无法继续删除\"
	]
	for i in range(logs.size()):
		await get_tree().create_timer(1.0).timeout
		progress_label.text = logs[i]
	await tween.finished
	progress_label.text = \"[错误 0x80070005] 卸载程序已停止响应，请重试...\"
	can_drag = true

func _on_progress_overlay_gui_input(event: InputEvent):
	if not can_drag:
		return
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed:
			_activate_host_window()
			is_dragging = true
			_update_progress_drag(event.global_position.x)
			accept_event()
		else:
			is_dragging = false
	elif event is InputEventMouseMotion and is_dragging:
		_update_progress_drag(event.global_position.x)
		accept_event()

func _input(event: InputEvent):
	if not can_drag or not is_dragging:
		return
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if not event.pressed:
			is_dragging = false
	elif event is InputEventMouseMotion:
		_update_progress_drag(event.global_position.x)

func _update_progress_drag(global_x: float):
	var overlay_rect = progress_overlay.get_global_rect()
	if overlay_rect.size.x <= 0:
		return
	var local_x = global_x - overlay_rect.position.x
	var ratio = local_x / overlay_rect.size.x
	var new_value = clamp(ratio * 100.0, progress_bar.value, 100.0)
	progress_bar.value = new_value
	if new_value >= 99.0:
		can_drag = false
		is_dragging = false
		_complete_uninstall()

func _complete_uninstall():	
	uninstall_completed = true	
	progress_label.text = \"卸载完成！感谢您曾经的支持（并不）。\"
	cancel_btn.text = \"完成\"
	cancel_btn.disabled = false
"

